# Copie este arquivo para .env e preencha os valores.
# O .env nunca deve ir para o repositório (já está no .gitignore).

# ---------- API ----------

# Connection string do Supabase (botão Connect > Direct > Connection string)
#   Desenvolvimento local: Session pooler (porta 5432)
#   Publicação na Vercel:  Transaction pooler (porta 6543)
DATABASE_URL=postgresql://postgres.ID_DO_PROJETO:SENHA@HOST.pooler.supabase.com:5432/postgres

# Porta da API no ambiente local
PORT=3000

# Endereço da interface autorizado no CORS
CORS_ORIGIN=http://localhost:5173

# ---------- Interface ----------

# Endereço da API consumida pela interface
# (o prefixo VITE_ vale para projetos Vite/React; ajuste se o framework for outro)
VITE_API_URL=http://localhost:3000
